{
  "name": "kart-wasteland",
  "version": "1.0.0",
  "description": "Простая гоночная игра на Three.js",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Антон Лабухин 1989",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test --outDir dist-test",
    "build:yandex": "vite build --mode yandex --outDir dist-yandex && node scripts/zip-yandex.mjs",
    "preview": "vite preview",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:edge": "playwright test -c playwright.edge.config.js",
    "test:e2e:slow": "playwright test -c playwright.swift.config.js",
    "test:e2e:smoke": "playwright test --project=site --grep=@smoke",
    "test:pr": "npm run test:unit && npm run test:e2e:smoke",
    "test:full": "npm test",
    "art": "playwright test -c tools/art/playwright.art.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.185.4",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/russo-one": "^5.3.0",
    "three": "^0.185.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
